DATABASE_URL=postgresql://dischat:replace-with-a-strong-runtime-password@postgres:5432/dischat

# Password for the bundled PostgreSQL in docker-compose.yml.
# Replace both placeholders before first startup. POSTGRES_PASSWORD must stay
# in sync with DATABASE_URL above
# (percent-encode URI-reserved characters - see docs/docker.md).
POSTGRES_ADMIN_PASSWORD=replace-with-a-different-strong-admin-password
POSTGRES_PASSWORD=replace-with-a-strong-runtime-password
# Only for the first startup with a volume created by the older single-role
# Compose setup, if that role still uses a different previous password.
# POSTGRES_LEGACY_PASSWORD=previous-dischat-password

MATRIX_HOMESERVER_URL=https://matrix.example.org
MATRIX_ACCESS_TOKEN=
MATRIX_BOT_MXID=@discourse-bridge:example.org
# Stable device id associated with MATRIX_ACCESS_TOKEN, or the id to reuse for
# password login. Required and verified at startup for Matrix tx-id deduplication.
MATRIX_DEVICE_ID=DISCHATBOT

DISCOURSE_BASE_URL=https://discourse.example.org
DISCOURSE_API_KEY=
DISCOURSE_SYSTEM_USERNAME=aosus

DISCOURSE_RELAY_MATRIX_USERNAME=MatrixRelayUser
DISCOURSE_RELAY_TELEGRAM_USERNAME=TelegramRelayUser
DISCOURSE_RELAY_DISCORD_USERNAME=DiscordRelayUser

POLL_INTERVAL_SECONDS=60
DELIVERY_JOB_LEASE_SECONDS=120
MATRIX_EVENT_RETENTION_DAYS=7
CONFIG_FILE=config.yaml
DEFAULT_LOCALE=ar

# Live E2E only. Never set this in a normal deployment. The runtime rejects
# every value except the dedicated private test category 56.
# DISCOURSE_TEST_CATEGORY_ID=56
